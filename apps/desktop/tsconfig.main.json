{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.config.ts"
  ]
}
