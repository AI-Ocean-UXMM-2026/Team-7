NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Required in production: At least 32-character dedicated secret for secure session signing
# Generate with: openssl rand -base64 32
SESSION_SECRET=dedicated-secure-session-secret-at-least-32-chars

# Optional server-only AI extraction. Never expose these as NEXT_PUBLIC_* values.
# OPENAI_API_KEY=
# AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
# AI_CHAT_MODEL=gpt-4o-mini
# Screenshot extraction uses a separate vision-capable model/configuration. Do not assume the chat model accepts images.
# AI_VISION_API_KEY=
# AI_VISION_API_URL=https://api.openai.com/v1/chat/completions
# AI_VISION_MODEL=gpt-4o-mini

