{
  "name": "ocean-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ocean/web dev",
    "build": "pnpm --filter @ocean/web build",
    "start": "pnpm --filter @ocean/web start",
    "desktop:dev": "pnpm --filter @ocean/desktop dev",
    "desktop:build": "pnpm --filter @ocean/desktop build",
    "desktop:package": "pnpm --filter @ocean/desktop package",
    "desktop:start": "pnpm --filter @ocean/desktop start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "typescript": "5.9.3"
  }
}
